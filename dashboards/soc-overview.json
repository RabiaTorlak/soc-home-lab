{
  "__inputs": [
    {
      "name": "DS_WAZUH",
      "label": "Wazuh Indexer (OpenSearch)",
      "description": "wazuh-alerts-* indeksini sorgulayan OpenSearch datasource",
      "type": "datasource",
      "pluginId": "grafana-opensearch-datasource",
      "pluginName": "OpenSearch"
    }
  ],
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "uid": "soc-overview-wazuh",
  "title": "SOC Overview - Wazuh SIEM",
  "tags": ["soc", "wazuh", "mitre", "blue-team"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "min_level",
        "label": "Min Kural Seviyesi",
        "type": "custom",
        "query": "0,5,7,10,12",
        "current": {"text": "7", "value": "7"},
        "options": [
          {"text": "0", "value": "0", "selected": false},
          {"text": "5", "value": "5", "selected": false},
          {"text": "7", "value": "7", "selected": true},
          {"text": "10", "value": "10", "selected": false},
          {"text": "12", "value": "12", "selected": false}
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Toplam Alarm (seçili aralık)",
      "type": "stat",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "targets": [
        {
          "refId": "A",
          "query": "rule.level:>=$min_level",
          "metrics": [{"id": "1", "type": "count"}],
          "bucketAggs": [
            {"id": "2", "type": "date_histogram", "field": "timestamp", "settings": {"interval": "1y"}}
          ],
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 2,
      "title": "Yüksek Seviye Alarm (level>=10)",
      "type": "stat",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [
        {"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "targets": [
        {
          "refId": "A",
          "query": "rule.level:>=10",
          "metrics": [{"id": "1", "type": "count"}],
          "bucketAggs": [
            {"id": "2", "type": "date_histogram", "field": "timestamp", "settings": {"interval": "1y"}}
          ],
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 3,
      "title": "Benzersiz Saldırgan IP",
      "type": "stat",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"},
      "targets": [
        {
          "refId": "A",
          "query": "data.srcip:*",
          "metrics": [{"id": "1", "type": "cardinality", "field": "data.srcip"}],
          "bucketAggs": [
            {"id": "2", "type": "date_histogram", "field": "timestamp", "settings": {"interval": "1y"}}
          ],
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 4,
      "title": "Benzersiz MITRE Tekniği",
      "type": "stat",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"},
      "targets": [
        {
          "refId": "A",
          "query": "rule.mitre.id:*",
          "metrics": [{"id": "1", "type": "cardinality", "field": "rule.mitre.id"}],
          "bucketAggs": [
            {"id": "2", "type": "date_histogram", "field": "timestamp", "settings": {"interval": "1y"}}
          ],
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 5,
      "title": "Zaman İçinde Alarmlar (seviyeye göre)",
      "type": "timeseries",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 4},
      "targets": [
        {
          "refId": "A",
          "query": "rule.level:>=$min_level",
          "metrics": [{"id": "1", "type": "count"}],
          "bucketAggs": [
            {"id": "3", "type": "terms", "field": "rule.level",
             "settings": {"order": "desc", "orderBy": "_count", "size": "6"}},
            {"id": "2", "type": "date_histogram", "field": "timestamp",
             "settings": {"interval": "auto"}}
          ],
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 6,
      "title": "En Çok Tetiklenen Kurallar",
      "type": "table",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 4},
      "targets": [
        {
          "refId": "A",
          "query": "rule.level:>=$min_level",
          "metrics": [{"id": "1", "type": "count"}],
          "bucketAggs": [
            {"id": "2", "type": "terms", "field": "rule.description",
             "settings": {"order": "desc", "orderBy": "_count", "size": "10"}}
          ],
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 7,
      "title": "En Çok Saldırgan IP (Top 10)",
      "type": "table",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 13},
      "targets": [
        {
          "refId": "A",
          "query": "data.srcip:*",
          "metrics": [{"id": "1", "type": "count"}],
          "bucketAggs": [
            {"id": "2", "type": "terms", "field": "data.srcip",
             "settings": {"order": "desc", "orderBy": "_count", "size": "10"}}
          ],
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 8,
      "title": "MITRE ATT&CK Teknikleri",
      "type": "piechart",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 13},
      "targets": [
        {
          "refId": "A",
          "query": "rule.mitre.id:*",
          "metrics": [{"id": "1", "type": "count"}],
          "bucketAggs": [
            {"id": "2", "type": "terms", "field": "rule.mitre.id",
             "settings": {"order": "desc", "orderBy": "_count", "size": "10"}}
          ],
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 9,
      "title": "Agent Bazında Alarm",
      "type": "table",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 13},
      "targets": [
        {
          "refId": "A",
          "query": "rule.level:>=$min_level",
          "metrics": [{"id": "1", "type": "count"}],
          "bucketAggs": [
            {"id": "2", "type": "terms", "field": "agent.name",
             "settings": {"order": "desc", "orderBy": "_count", "size": "10"}}
          ],
          "timeField": "timestamp"
        }
      ]
    }
  ]
}
