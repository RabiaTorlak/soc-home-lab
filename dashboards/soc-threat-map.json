{
  "__inputs": [
    {
      "name": "DS_WAZUH",
      "label": "Wazuh Indexer (OpenSearch)",
      "description": "wazuh-alerts-* indeksini sorgulayan OpenSearch datasource",
      "type": "datasource",
      "pluginId": "grafana-opensearch-datasource",
      "pluginName": "OpenSearch"
    }
  ],
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "title": "SOC Threat Map — Taktik & Coğrafya",
  "uid": "soc-threat-map",
  "tags": ["soc", "wazuh", "mitre", "threat-intel"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "MITRE Taktik Kırılımı",
      "type": "piechart",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 10, "w": 10, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "query": "rule.mitre.tactic:*",
          "metrics": [{"id": "1", "type": "count"}],
          "bucketAggs": [
            {"id": "2", "type": "terms", "field": "rule.mitre.tactic",
             "settings": {"order": "desc", "orderBy": "_count", "size": "12"}}
          ],
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 2,
      "title": "Kural Seviyesi Dağılımı",
      "type": "bargauge",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 10, "w": 14, "x": 10, "y": 0},
      "options": {"orientation": "horizontal", "displayMode": "gradient"},
      "targets": [
        {
          "refId": "A",
          "query": "rule.level:>=5",
          "metrics": [{"id": "1", "type": "count"}],
          "bucketAggs": [
            {"id": "2", "type": "terms", "field": "rule.level",
             "settings": {"order": "desc", "orderBy": "_term", "size": "15"}}
          ],
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 3,
      "title": "Saldırgan Coğrafi Harita (Wazuh GeoIP gerektirir)",
      "type": "geomap",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 10},
      "options": {
        "view": {"id": "zero", "lat": 20, "lon": 0, "zoom": 1.5},
        "basemap": {"type": "default", "name": "Layer 0"},
        "layers": [
          {
            "type": "markers",
            "name": "Saldırgan IP'ler",
            "config": {"size": {"fixed": 6}, "color": {"fixed": "#E01030"}}
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "query": "data.srcip:*",
          "metrics": [{"id": "1", "type": "count"}],
          "bucketAggs": [
            {"id": "2", "type": "geohash_grid", "field": "GeoLocation.location",
             "settings": {"precision": "3"}}
          ],
          "timeField": "timestamp"
        }
      ]
    },
    {
      "id": 4,
      "title": "Saldırgan Ülke Dağılımı",
      "type": "table",
      "datasource": {"type": "grafana-opensearch-datasource", "uid": "${DS_WAZUH}"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 22},
      "targets": [
        {
          "refId": "A",
          "query": "GeoLocation.country_name:*",
          "metrics": [{"id": "1", "type": "count"}],
          "bucketAggs": [
            {"id": "2", "type": "terms", "field": "GeoLocation.country_name",
             "settings": {"order": "desc", "orderBy": "_count", "size": "15"}}
          ],
          "timeField": "timestamp"
        }
      ]
    }
  ]
}
