<!-- ============================================================
     SOC Lab - Özel Tespit Kuralları (local_rules.xml)
     MITRE ATT&CK eşleşmeli Sigma -> Wazuh kuralları.
     Mevcut kurallarının (100101, 100102) ALTINA ekle.
     Uygulama sonrası: sudo systemctl restart wazuh-manager
     Not: Sysmon grup adları (sysmon_event1 / sysmon_event_10)
          Wazuh sürümüne göre değişebilir; doğrulamak için:
          grep -R "sysmon_event" /var/ossec/ruleset/rules/ | head
     ============================================================ -->

<group name="local,sysmon,sigma,mitre,">

  <!-- 100103 - Credential Access: LSASS belleğine erişim (olası Mimikatz) -->
  <rule id="100103" level="12">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(1010|1410|1438|143a|1fffff)$</field>
    <description>Credential Dumping: Supheli LSASS bellek erisimi (olasi Mimikatz) [T1003.001]</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,</group>
  </rule>

  <!-- 100104 - Persistence: schtasks ile zamanlanmış görev oluşturma -->
  <rule id="100104" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>Persistence: schtasks.exe ile zamanlanmis gorev olusturuldu [T1053.005]</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,</group>
  </rule>

  <!-- 100105 - Defense Evasion: Windows Defender devre dışı bırakma / kurcalama -->
  <rule id="100105" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(Set-MpPreference\s+.*-Disable(RealtimeMonitoring|IOAVProtection|BehaviorMonitoring)|Add-MpPreference\s+-ExclusionPath|(sc|net)(\.exe)?\s+stop\s+WinDefend)</field>
    <description>Defense Evasion: Windows Defender devre disi birakildi / kurcalandi [T1562.001]</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>defense_evasion,</group>
  </rule>

  <!-- 100106 - Persistence/PrivEsc: yeni yerel hesap veya Administrators'a ekleme -->
  <rule id="100106" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(net\d?\s+user\s+\S+\s+\S+\s+/add|net\d?\s+localgroup\s+administrators\s+\S+\s+/add)</field>
    <description>Account Manipulation: Yeni yerel hesap olusturuldu veya Administrators grubuna eklendi [T1136.001]</description>
    <mitre>
      <id>T1136.001</id>
      <id>T1098</id>
    </mitre>
    <group>account_manipulation,</group>
  </rule>

  <!-- 100107 - Execution/C2: PowerShell / certutil ile uzaktan yük indirme -->
  <rule id="100107" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(Net\.WebClient|DownloadString|DownloadFile|Invoke-WebRequest|\biwr\b|Start-BitsTransfer|certutil(\.exe)?\s+.*-urlcache)</field>
    <description>Ingress Tool Transfer: PowerShell/certutil ile uzaktan yuk indirme girisimi [T1105]</description>
    <mitre>
      <id>T1105</id>
      <id>T1059.001</id>
    </mitre>
    <group>execution,command_and_control,</group>
  </rule>

  <!-- 100108 - Persistence: Registry Run Key (reg add ...\Run) -->
  <rule id="100108" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)reg(\.exe)?\s+add\s+.*\\(CurrentVersion\\Run|RunOnce)</field>
    <description>Persistence: Registry Run Key eklendi (reg add) [T1547.001]</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>persistence,</group>
  </rule>

  <!-- 100109 - Defense Evasion: Windows olay günlüklerini temizleme -->
  <rule id="100109" level="13">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(wevtutil\s+(cl|clear-log)|Clear-EventLog)</field>
    <description>Defense Evasion: Windows olay gunlukleri temizlendi [T1070.001]</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>defense_evasion,</group>
  </rule>

  <!-- 100110 - Discovery: Remote System Discovery (net view / nltest) -->
  <rule id="100110" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(net\d?\s+view|nltest\s+/dclist|net\d?\s+group\s+"?domain computers"?)</field>
    <description>Discovery: Remote System Discovery (net view / nltest) [T1018]</description>
    <mitre>
      <id>T1018</id>
    </mitre>
    <group>discovery,</group>
  </rule>

  <!-- 100111 - Lateral Movement: RDP etkinleştirme (fDenyTSConnections=0) -->
  <rule id="100111" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)reg(\.exe)?\s+add\s+.*fDenyTSConnections.*\s0\b</field>
    <description>Lateral Movement: RDP etkinlestirildi (fDenyTSConnections=0) [T1021.001]</description>
    <mitre>
      <id>T1021.001</id>
    </mitre>
    <group>lateral_movement,</group>
  </rule>

  <!-- 100112 - Discovery: System Network Configuration Discovery -->
  <rule id="100112" level="6">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(ipconfig\s+/all|arp\s+-a|route\s+print|netsh\s+interface\s+show)</field>
    <description>Discovery: System Network Configuration Discovery [T1016]</description>
    <mitre>
      <id>T1016</id>
    </mitre>
    <group>discovery,</group>
  </rule>

</group>
